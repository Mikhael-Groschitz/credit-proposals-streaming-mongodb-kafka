# Copie este arquivo para infra/.env antes de subir o ambiente.
# scripts/bootstrap.sh faz essa copia automaticamente se infra/.env nao existir.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_REPLICA_SET=rs0
MONGO_DB=creditodb
MONGO_COLLECTION=propostas

# ---------------------------------------------------------------------------
# Kafka (KRaft, broker unico)
# ---------------------------------------------------------------------------
# Gerado uma unica vez por scripts/generate-kafka-cluster-id.sh e persistido
# aqui. Nao gere um novo CLUSTER_ID sem tambem remover o volume kafka-data,
# ou o broker recusa subir por inconsistencia de metadados de storage.
KAFKA_CLUSTER_ID=
KAFKA_TOPIC_PROPOSTAS=propostas.cdc
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# ---------------------------------------------------------------------------
# Gerador de carga operacional
# ---------------------------------------------------------------------------
# Taxa alvo de operacoes por segundo (criacoes + transicoes + deletes + correcoes).
EVENTS_PER_SECOND=5.0

# Peso relativo de cada tipo de produto para propostas NOVAS (nao precisam somar 1).
RATIO_CONSIGNADO=0.5
RATIO_CARTAO=0.3
RATIO_FGTS=0.2

# Fracao dos eventos que criam uma proposta nova vs. avancam uma ja existente.
RATIO_NEW_VS_TRANSITION=0.3

# Fracao das propostas recem-criadas que sofrem delete (erro operacional simulado).
RATIO_DELETE=0.02

# Fracao dos eventos que sao correcao retroativa (replace de campo de negocio,
# sem mudar status).
RATIO_CORRECAO=0.05

# Deixe vazio para aleatoriedade nao determinística, ou defina um inteiro para
# reproduzir a mesma sequencia de eventos entre execucoes.
RANDOM_SEED=

# ---------------------------------------------------------------------------
# Conector de change streams
# ---------------------------------------------------------------------------
# Timeouts do producer Kafka usados para detectar broker indisponivel em
# segundos, nao minutos (ver README, secao Decisoes e trade-offs da Fase 2).
KAFKA_DELIVERY_TIMEOUT_MS=15000
KAFKA_REQUEST_TIMEOUT_MS=5000

# Onde o resume token e persistido (dentro do proprio MongoDB, banco MONGO_DB).
CHECKPOINT_COLLECTION=checkpoints
CHECKPOINT_ID=conector-propostas

# O resume token so avanca depois que um lote inteiro e confirmado no Kafka.
# O lote fecha ao atingir o tamanho OU o intervalo maximo, o que vier primeiro.
BATCH_MAX_SIZE=50
BATCH_MAX_INTERVALO_MS=2000

# Backoff exponencial usado ao perder conexao com o Mongo ou com o Kafka.
RETRY_BACKOFF_INICIAL_MS=1000
RETRY_BACKOFF_MAXIMO_MS=30000

LOG_LEVEL=INFO
