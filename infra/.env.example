MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_REPLICA_SET=rs0
MONGO_DB=creditodb
MONGO_COLLECTION=propostas

KAFKA_CLUSTER_ID=
KAFKA_TOPIC_PROPOSTAS=propostas.cdc
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

EVENTS_PER_SECOND=5.0

RATIO_CONSIGNADO=0.5
RATIO_CARTAO=0.3
RATIO_FGTS=0.2

RATIO_NEW_VS_TRANSITION=0.3

RATIO_DELETE=0.02

RATIO_CORRECAO=0.05

RANDOM_SEED=

KAFKA_DELIVERY_TIMEOUT_MS=15000
KAFKA_REQUEST_TIMEOUT_MS=5000

CHECKPOINT_COLLECTION=checkpoints
CHECKPOINT_ID=conector-propostas

BATCH_MAX_SIZE=50
BATCH_MAX_INTERVALO_MS=2000

RETRY_BACKOFF_INICIAL_MS=1000
RETRY_BACKOFF_MAXIMO_MS=30000

BRONZE_PATH=s3a://bronze/propostas
BRONZE_CHECKPOINT_PATH=s3a://bronze/_checkpoints/propostas

BRONZE_TRIGGER_INTERVALO="10 seconds"

BRONZE_SHUFFLE_PARTITIONS=6

SILVER_HISTORICO_PATH=s3a://silver/historico
SILVER_ESTADO_ATUAL_PATH=s3a://silver/estado_atual
SILVER_CHECKPOINT_PATH=s3a://silver/_checkpoints/propostas

SILVER_WATERMARK_ATRASO="10 minutes"

SILVER_TRIGGER_INTERVALO="10 seconds"
SILVER_SHUFFLE_PARTITIONS=6

GOLD_FUNIL_PATH=s3a://gold/funil_status
GOLD_VOLUME_VALOR_PATH=s3a://gold/volume_valor_por_produto
GOLD_TEMPO_DECISAO_PATH=s3a://gold/tempo_decisao
GOLD_CONTAGEM_ATUAL_PATH=s3a://gold/contagem_atual_por_status
GOLD_VIOLACOES_PATH=s3a://gold/qualidade_violacoes

GOLD_CHECKPOINT_FUNIL_PATH=s3a://gold/_checkpoints/funil
GOLD_CHECKPOINT_VOLUME_VALOR_PATH=s3a://gold/_checkpoints/volume_valor
GOLD_CHECKPOINT_METRICAS_PATH=s3a://gold/_checkpoints/metricas
GOLD_CHECKPOINT_QUALIDADE_BRONZE_PATH=s3a://gold/_checkpoints/qualidade_bronze
GOLD_CHECKPOINT_QUALIDADE_HISTORICO_PATH=s3a://gold/_checkpoints/qualidade_historico

GOLD_WATERMARK_ATRASO="10 minutes"

GOLD_JANELA_FUNIL="1 day"

GOLD_TRIGGER_INTERVALO="10 seconds"
GOLD_SHUFFLE_PARTITIONS=6

LOG_LEVEL=INFO
